PORT=5000
NODE_ENV=development
# MongoDB Atlas or local instance. The server refuses to start without it.
MONGODB_URI=mongodb://127.0.0.1:27017/mediguide
# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=30d
# Comma separated browser origins allowed to call the API (your deployed frontend)
CLIENT_ORIGIN=http://localhost:5173
# Optional: without a key the built-in local triage engine is used
# Google Gemini powers Nura. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (defaults: gemini-3.5-flash, fallback gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Timezone used for session dates/times (IANA name)
CLINIC_TIMEZONE=Asia/Karachi
