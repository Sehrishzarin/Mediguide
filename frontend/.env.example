# Backend base URL. With or without the trailing /api both work.
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api
# Deployed backend (also use this value for Android/Capacitor builds):
# VITE_API_BASE_URL=https://your-backend.onrender.com

# Set to false to hide the "Demo accounts" shortcuts on the login screen
# VITE_SHOW_DEMO_LOGINS=false
